    "privacy_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports are saved only after preview and your explicit request. No upload or telemetry."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raporty są zapisywane po podglądzie i na Twoje żądanie. Bez wysyłania i telemetrii."
          }
        }
      }
    },
    "vpn_active": {
      "localizations": {
        "en": {
          "stringUnit": {
