{
  "sourceLanguage": "en",
  "strings": {
    "device_test": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection test to a device"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Test połączenia z urządzeniem"
          }
        }
      }
    },
    "device_test_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only TCP connect to a name or address on your network. The name and port stay here; the activity log keeps only the outcome and interface type."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytowe połączenie TCP z nazwą lub adresem w Twojej sieci. Nazwa i port zostają tutaj; dziennik aktywności zapisuje tylko wynik i typ interfejsu."
          }
        }
      }
    },
    "device_host": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name or address, e.g. Mac-Studio.local"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa lub adres, np. Mac-Studio.local"
          }
        }
      }
    },
    "device_port": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Port"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Port"
          }
        }
      }
    },
    "device_test_run": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test connection"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź połączenie"
          }
        }
      }
    },
    "state_residual": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network works, VPN leftovers remain"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieć działa, pozostały ślady VPN"
          }
        }
      }
    },
    "state_residual_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The checks passed. The VPN client left inactive tunnel devices behind; ordinary network repairs stay blocked until they disappear."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrole przeszły. Klient VPN zostawił nieaktywne interfejsy tunelowe; zwykłe naprawy sieci pozostają zablokowane, dopóki nie znikną."
          }
        }
      }
    },
    "result_residual": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The checks passed; the VPN client left inactive tunnel devices without routes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrole przeszły; klient VPN zostawił nieaktywne interfejsy tunelowe bez tras."
          }
        }
      }
    },
    "next_residual": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local network works. To remove the leftover devices, quit and reopen the VPN client or restart the Mac; the app does not terminate other processes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieć lokalna działa. Aby usunąć pozostałe interfejsy, zamknij i uruchom ponownie klienta VPN albo komputer; aplikacja nie kończy cudzych procesów."
          }
        }
      }
    },
    "status": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stan"
          }
        }
      }
    },
