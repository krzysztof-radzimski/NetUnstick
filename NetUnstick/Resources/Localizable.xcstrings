            "state": "translated",
            "value": "Stan VPN nie pozwala na jednoznaczny wynik."
          }
        }
      }
    },
    "next_vpn_unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect VPN or confirm its status, then run diagnostics again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozłącz VPN lub potwierdź jego stan, a potem ponów diagnostykę."
          }
        }
      }
    },
    "check_skipped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not conclusive"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik niejednoznaczny"
          }
        }
      }
    },
    "check_cancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulowano"
          }
        }
      }
    },
    "check_permission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission denied"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmowa dostępu"
          }
        }
      }
    },
    "check_timeout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed out"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekroczono czas"
          }
        }
      }
    },
    "result_permission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local discovery could not run because access was denied."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkrywanie lokalne nie mogło się uruchomić, ponieważ system odmówił dostępu."
          }
        }
      }
    },
    "next_permission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check local network permission in System Settings, then run diagnostics again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź uprawnienie do sieci lokalnej w Ustawieniach systemowych, a potem ponów diagnostykę."
          }
        }
      }
    },
    "result_timeout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network check did not finish in time."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzenie sieci nie zakończyło się w wyznaczonym czasie."
          }
        }
      }
    },
    "next_timeout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the connection and try the diagnosis again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź połączenie i ponów diagnostykę."
          }
        }
      }
    },
    "result_no_receiver": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No local receiver was found; this does not prove a network fault."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono lokalnego odbiornika; samo to nie dowodzi awarii sieci."
          }
        }
      }
    },
    "next_no_receiver": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure the receiver is on and on the same local network, then try again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upewnij się, że odbiornik jest włączony i korzysta z tej samej sieci lokalnej, a potem spróbuj ponownie."
          }
        }
      }
    },
    "export_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report could not be saved"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać raportu"
          }
        }
      }
    },
    "export_failed_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a writable location and try again from the preview."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz miejsce, w którym możesz zapisać plik, i spróbuj ponownie z podglądu."
          }
        }
      }
    },
    "ok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "wait_or_cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the result or cancel the operation."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj na wynik albo anuluj operację."
          }
        }
      }
    },
    "state_sharing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network works; this Mac is not ready to share files"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieć działa; ten Mac nie jest gotowy do udostępniania plików"
          }
        }
      }
    },
    "state_sharing_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other Macs reach this Mac, but a file sharing setting blocks logging in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne komputery Mac docierają do tego Maca, ale ustawienie udostępniania plików blokuje logowanie."
          }
        }
      }
    },
    "result_sharing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network checks passed; your account has no SMB password stored, so other Macs cannot log in to this Mac’s shared folders."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrole sieci przeszły; Twoje konto nie ma zapisanego hasła SMB, więc inne komputery Mac nie mogą zalogować się do udostępnionych folderów tego Maca."
          }
        }
      }
    },
    "next_sharing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings › General › Sharing › File Sharing › ⓘ › Options…, turn on your account under “Share files and folders using SMB” and enter your password; then use “Connect As…” on the other Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Ustawienia systemowe › Ogólne › Udostępnianie › Udostępnianie plików › ⓘ › Opcje…, włącz swoje konto w „Udostępnianie plików i folderów za pomocą SMB” i podaj hasło; potem na drugim Macu wybierz „Połącz jako…”."
          }
        }
      }
    },
    "result_sharing_nologin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network checks passed, but this Mac rejects guest logins and your account has no SMB password stored, so no computer can log in to its shared folders."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrole sieci przeszły, ale ten Mac odrzuca logowanie gościa, a Twoje konto nie ma zapisanego hasła SMB, więc żaden komputer nie zaloguje się do jego udostępnionych folderów."
          }
        }
      }
    },
    "next_sharing_nologin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings › General › Sharing › File Sharing › ⓘ › Options…, turn on your account under “Share files and folders using SMB” and enter your password. Optionally allow guests under Users & Groups › Guest User › “Allow guests to connect to shared folders”. Then use “Connect As…” on the other Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Ustawienia systemowe › Ogólne › Udostępnianie › Udostępnianie plików › ⓘ › Opcje…, włącz swoje konto w „Udostępnianie plików i folderów za pomocą SMB” i podaj hasło. Opcjonalnie w Użytkownicy i grupy › Gość włącz „Zezwalaj gościom na łączenie się z udostępnianymi folderami”. Potem na drugim Macu wybierz „Połącz jako…”."
          }
        }
      }
    }
  },
  "version": "1.0"
}
