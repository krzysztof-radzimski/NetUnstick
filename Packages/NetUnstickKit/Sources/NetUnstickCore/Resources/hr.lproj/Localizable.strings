"privacy_local_body" = "NetUnstick nema račune, oglase, analitiku, praćenje ni slanje u pozadini. Mrežna opažanja obrađuju se na ovom Macu. Nazivi uređaja, SSID-ovi, adrese, interne domene, vjerodajnice i sadržaj paketa izostavljaju se ili redigiraju u povijesti i izvješćima.";
"privacy_local_title" = "Lokalna obrada";
"privacy_network_body" = "Na vaš zahtjev dijagnostika razrješava example.com vašim razrješivačem, povezuje se s 1.1.1.1:443 i traži lokalne Bonjour usluge. Provjera uređaja kontaktira uneseni cilj. DNS pružatelji i kontaktirani uređaji vide uobičajene mrežne metapodatke, uključujući izvornu adresu. Razvojnom programeru ne šalje se dijagnostičko izvješće. Kada je provjera uključena, aplikacija pri pokretanju dohvaća datoteku verzije s itorg.pl. To možete isključiti. PKG se preuzima nakon klika. Hosting prima uobičajene HTTP metapodatke, uključujući IP adresu, ali ne izvješća ni identifikator uređaja.";
"privacy_network_title" = "Mrežni promet";
"privacy_permissions_body" = "Provjere možete otkazati i opozvati pristup lokalnoj mreži u Postavkama sustava. Puno izdanje omogućuje i odjavu pomoćne usluge. Izvoz i dijeljenje izvješća nisu obvezni. Podatke koje pošaljete podršci obrađuje primatelj.";
"privacy_permissions_title" = "Vaši odabiri";
"privacy_retention_body" = "Lokalna povijest čuva najviše 20 sesija, 100 zapisa po sesiji i 4 MB: vremena, verzije aplikacije i macOS-a, kodove rezultata i pogrešaka te pročišćene podatke. Izbrišite je u Postavkama. Izvješća se spremaju nakon pregleda i odabira datoteke; izvezene kopije izbrišite zasebno. macOS upravlja čuvanjem svojih privatnih sistemskih zapisa.";
"privacy_retention_title" = "Pohrana i brisanje";
"privacy_version_body" = "23. listopada 2026. Izdavač: ITORG Krzysztof Radzimski. Kontakt za privatnost: kr@itorg.pl.";
