"privacy_local_title" = "Krajevna obdelava";
"privacy_network_body" = "Na vašo zahtevo diagnostika razreši example.com prek vašega razreševalnika, se poveže z 1.1.1.1:443 in poišče krajevne storitve Bonjour. Preizkus naprave kontaktira vneseni cilj. Ponudniki DNS in kontaktirane naprave vidijo običajne omrežne metapodatke, tudi izvorni naslov. Razvijalcu se ne pošlje nobeno diagnostično poročilo. Če je preverjanje vključeno, aplikacija ob zagonu pridobi datoteko različice z itorg.pl. To lahko izklopite. PKG se prenese po kliku. Gostovanje prejme običajne metapodatke HTTP, tudi naslov IP, ne pa poročil ali identifikatorja naprave.";
"privacy_network_title" = "Omrežni promet";
"privacy_permissions_body" = "Preverjanja lahko prekličete in v sistemskih nastavitvah odvzamete dostop do krajevnega omrežja. Polna izdaja omogoča tudi odjavo pomožne storitve. Izvoz in deljenje poročila sta neobvezna. Podatke, ki jih pošljete podpori, obdeluje prejemnik.";
"privacy_permissions_title" = "Vaše izbire";
"privacy_retention_body" = "Krajevna zgodovina hrani največ 20 sej, 100 vnosov na sejo in 4 MB: čase, različice aplikacije in macOS, kode rezultatov in napak ter očiščene podatke. Izbrišete jo v Nastavitvah. Poročila se shranijo po predogledu in izbiri datoteke; izvožene kopije izbrišite posebej. Hrambo zasebnih sistemskih dnevnikov upravlja macOS.";
"privacy_retention_title" = "Shranjevanje in brisanje";
